{
  "manifest_version": 3,
  "name": "AI Chat Engine Android Bridge",
  "version": "1.0.0",
  "description": "Built-in GeckoView bridge for real AI chat websites. No provider APIs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-chat-engine@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
